# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgres://user:password@host:5432/floodguard
DB_NAME=floodguard
DB_USER=postgres
DB_PASSWORD=your-secure-db-password
DB_HOST=db
DB_PORT=5432
DB_SSL_REQUIRE=True

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SSL_CERT_REQS=required

# Africa's Talking SMS API (required for SMS alerts)
AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_API_KEY=your_api_key
SMS_ENABLED=True

# Multi-source flood intelligence APIs
OPENWEATHER_API_KEY=your_openweather_api_key
TOMORROW_IO_API_KEY=your_tomorrow_io_api_key
WEATHERAPI_KEY=your_weatherapi_key
NASA_EARTHDATA_TOKEN=your_nasa_earthdata_token
GEE_SERVICE_ACCOUNT_KEY_PATH=/path/to/gee_service_account.json

# AI analysis and chatbot
GROQ_API_KEY=your_groq_api_key

# Safe Route / GraphHopper API (required for route planning)
GRAPHOPHER_API_KEY=your_graphhopper_api_key

# Geographic bounds (format: min_lon,min_lat,max_lon,max_lat)
GEO_BOUNDS=33.0,-5.0,42.0,5.0

# Risk calculation weights (configurable for different regions)
RISK_WEIGHT_DISCHARGE_CURRENT=0.50
RISK_WEIGHT_DISCHARGE_24H=0.30
RISK_WEIGHT_DISCHARGE_7D=0.20
RISK_WEIGHT_PRECIP=0.30
RISK_WEIGHT_HUMIDITY=0.60
RISK_WEIGHT_SAR_WATER=0.40
RISK_WEIGHT_DISCHARGE=0.45
RISK_WEIGHT_ENVIRONMENTAL=0.25
RISK_CONFIDENCE_PENALTY_1=0.80
RISK_CONFIDENCE_PENALTY_2=0.90

# Risk thresholds
RISK_THRESHOLD_CRITICAL=0.85
RISK_THRESHOLD_HIGH=0.70
RISK_THRESHOLD_MODERATE=0.40

# H3 resolution configuration
H3_RESOLUTION_URBAN=7
H3_RESOLUTION_RURAL=5
H3_RESOLUTION_SEMI_URBAN=6
H3_RESOLUTION_FOREST=5
H3_RESOLUTION_MOUNTAIN=4
H3_RESOLUTION_COASTAL=6
H3_RISK_MAX_AGE_SECONDS=3600

# Email Configuration (for email alerts)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FloodGuard <noreply@floodguard.com>

# Security (for production - set all to True in production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
